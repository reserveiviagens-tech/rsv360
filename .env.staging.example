# RSV360 Staging — template de variáveis (auth D2.8 + D2.9)
#
# Como usar:
#   1. Copie para o servidor de staging:  cp .env.staging.example .env
#   2. Substitua todos os CHANGE_ME_* pelos valores reais
#   3. Edite o .env quando quiser — ele NÃO entra no git (.gitignore)
#
# Domínio de exemplo abaixo: staging.reserveiviagens.com.br
# Troque pelas URLs reais do seu ambiente antes do deploy.

# ============================================
# CORE
# ============================================
NODE_ENV=production
COMPOSE_PROJECT_NAME=rsv360-staging
RSV360_DOCKER_PROJECT=rsv360-staging

POSTGRES_USER=rsv360_staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_POSTGRES_PASSWORD
POSTGRES_DB=rsv360_staging_db
DATABASE_URL=postgresql://rsv360_staging:CHANGE_ME_STAGING_POSTGRES_PASSWORD@postgres:5432/rsv360_staging_db

# Redis (hostname do serviço Compose — não usar localhost dentro da stack)
REDIS_URL=redis://redis:6379

JWT_SECRET=CHANGE_ME_STAGING_JWT_SECRET_MIN_32_CHARS
# Prefer set; empty inherits JWT_SECRET until rotation
JWT_REFRESH_SECRET=
# PR-10c-pré-a — default OFF until admin/turismo migrate (pré-b)
AUTH_REFRESH_COOKIE_REQUIRED=false

# HTTP security headers (PR-05a) — HSTS only with TLS; never pin on HTTP lab
ENABLE_HSTS=false

# PR-05b — CORS allowlist + Prometheus scrape bearer
CORS_ORIGIN=https://staging.reserveiviagens.com.br
METRICS_TOKEN=CHANGE_ME_STAGING_METRICS_TOKEN_MIN_32_CHARS

# ============================================
# SITE PÚBLICO (URL canônica — OAuth + reset links)
# ============================================
NEXT_PUBLIC_SITE_URL=https://staging.reserveiviagens.com.br
NEXT_PUBLIC_API_URL=https://staging.reserveiviagens.com.br
NEXT_PUBLIC_BACKEND_URL=https://api-staging.reserveiviagens.com.br

# ============================================
# AUTH — OAUTH BFF (D2.9)
# ============================================
# Mesmo valor em backend E site-publico. Gere: openssl rand -hex 32
OAUTH_BFF_SECRET=CHANGE_ME_STAGING_OAUTH_BFF_SECRET

# Staging: use true até ter credenciais Google/Facebook; depois mude para false
# Modo mock: deixe GOOGLE_* e FACEBOOK_* vazios — login social usa usuário @oauth.local
OAUTH_DEV_MOCK=true

# Google Cloud Console → OAuth 2.0 Client (app staging separado ou mesmo app + URI extra)
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://staging.reserveiviagens.com.br/api/auth/google/callback

# Meta for Developers → Facebook Login
FACEBOOK_APP_ID=CHANGE_ME_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=CHANGE_ME_FACEBOOK_APP_SECRET
FACEBOOK_REDIRECT_URI=https://staging.reserveiviagens.com.br/api/auth/facebook/callback

# ============================================
# AUTH — PASSWORD RESET E-MAIL (D2.8) — backend
# ============================================
PASSWORD_RESET_BASE_URL=https://staging.reserveiviagens.com.br
PASSWORD_RESET_EMAIL_FROM=noreply@reserveiviagens.com.br

# Opção A: Webhook de teste (Mailtrap, n8n, etc.)
# Local Docker: npm run staging:webhook + URL abaixo
# PASSWORD_RESET_EMAIL_WEBHOOK=http://host.docker.internal:9876/password-reset
PASSWORD_RESET_EMAIL_WEBHOOK=
PASSWORD_RESET_EMAIL_WEBHOOK_SECRET=

# Opção B: SMTP sandbox (Mailtrap, SES sandbox, etc.)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASS
SMTP_FROM="Reservei Viagens Staging <noreply@reserveiviagens.com.br>"
SMTP_SECURE=false

# ============================================
# MONITORING (opcional)
# ============================================
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STAGING_GRAFANA
