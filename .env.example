# RSV360 Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit real secrets here.
# To use locally:
#   cp .env.example .env
# For docker compose, see the root docker-compose.yml and the app-specific compose files.

# ============================================
# DOCKER COMPOSE ISOLATION (multi-clone hosts)
# ============================================
# Clone principal: manter defaults abaixo.
# Worktrees/validação: use prefixo único (ex. rsv360-wt-validate).
COMPOSE_PROJECT_NAME=rsv360
RSV360_DOCKER_PROJECT=rsv360

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=postgres
DB_PORT=5432
# Volumes antigos do projeto usam rsv_360_ecosystem; installs novos podem usar rsv360.
# Apos clone: .\scripts\sync-postgres-docker-dev.ps1
DB_NAME=rsv_360_ecosystem
DB_USER=rsv360
# DEV ONLY: app-level password; use secret manager in production — never commit real values
DB_PASSWORD=CHANGE_ME_DEV_DB_PASSWORD
DATABASE_URL=postgresql://rsv360:CHANGE_ME_DEV_DB_PASSWORD@postgres:5432/rsv_360_ecosystem

# Container bootstrap values for `docker compose` / postgres image.
POSTGRES_USER=rsv360
# DEV ONLY: container bootstrap password; use secret manager in production — never commit real values
POSTGRES_PASSWORD=CHANGE_ME_DEV_POSTGRES_PASSWORD
POSTGRES_DB=rsv_360_ecosystem

# Grafana (docker-compose monitoring profile) — never commit a real password
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
GF_SECURITY_ADMIN_USER=admin

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
# Filled in production via secret manager
REDIS_PASSWORD=

# ============================================
# JWT CONFIGURATION
# ============================================
# Required (fail-closed). Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
# Optional — prefer JWT_REFRESH_SECRET; if empty, runtime inherits JWT_SECRET (compat até rotação 04b)
JWT_REFRESH_SECRET=
# PR-10c-pré-a — when true, reject refresh body unless BFF forwards cookie (default OFF: admin/turismo legado)
AUTH_REFRESH_COOKIE_REQUIRED=false
# Explicit reverse-proxy names/CIDRs trusted by Express for X-Forwarded-*.
# Cloudflare / nginx hops: docs/security/PR17-CLOUDFLARE.md (PR-12b-ops) — never commit prod CIDRs here.
TRUST_PROXY=loopback

# ============================================
# ADMIN AUTH
# ============================================
ADMIN_LOGIN_EMAIL=
ADMIN_LOGIN_PASSWORD=
ADMIN_JWT_SECRET=CHANGE_ME_ADMIN_JWT_SECRET_MIN_32_CHARS

# PR-06c — login protection + MFA TOTP (OFF by default; owner enables in coordinated window)
# AUTH_LOGIN_PROTECTION_ENABLED=true → Turnstile after 3 consecutive account failures + progressive lockout 15/30/60
AUTH_LOGIN_PROTECTION_ENABLED=false
# AUTH_MFA_ENFORCE=true → TOTP mandatory for admin|manager (staff DB · admin Next · AUTH_PILOT)
AUTH_MFA_ENFORCE=false
# PR-10b — step-up on new IP/UA (1B + 2B-lite). OFF = byte-identical to pre-10b. Owner enables.
AUTH_STEP_UP_ENABLED=false
# PR-10c-a1 — DPoP access (OFF = validation no-op; cnf.jkt still bound when proof presented)
AUTH_DPOP_ENABLED=false
# Enrollment window: explicit ISO start — NEVER deploy clock. Empty = window closed.
AUTH_MFA_ENROLLMENT_START_AT=
AUTH_MFA_ENROLLMENT_WINDOW_HOURS=72
# When protection requires Turnstile: missing TURNSTILE_SECRET_KEY denies (fail-closed)
AUTH_LOGIN_TURNSTILE_FAIL_CLOSED=true
# Admin ops endpoints (/api/v1/auth/admin/unlock-account · reset-mfa) — never public UI
AUTH_MFA_ADMIN_OPS=false
# Optional pilot login (dev only); MFA enforce requires DATABASE_URL
AUTH_PILOT_ENABLED=false
# Optional encryption key for TOTP secrets (falls back to JWT_SECRET)
TWO_FA_ENCRYPTION_KEY=
TWO_FA_ISSUER=RSV360

# QR voucher HMAC (PR 21) — mínimo 32 caracteres; compose lab exige valor (PR-09b fail-closed)
QR_SECRET=CHANGE_ME_QR_SECRET_MIN_32_CHARS
# Mercado Pago access token for backend compose (PR-09b — was hardcoded test-token)
MP_ACCESS_TOKEN=CHANGE_ME_MP_ACCESS_TOKEN
# ============================================
NODE_ENV=development
PORT=3001
PORT_BACKEND=3002
PORT_SITE_PUBLICO=3000
PORT_TURISMO=3005
PORT_ADMIN=3004
PORT_GUEST=3006
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_BACKEND_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Domínio oficial para QR de autenticidade do roteiro (produção: https://www.reserveiviagens.com.br)
PUBLIC_BASE_URL=
NEXT_PUBLIC_PUBLIC_BASE_URL=
# PR-05b — allowlist explícita (localhost + 127.0.0.1 × 3000/3001/3004/3005/3006). Never '*'.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3004,http://127.0.0.1:3005,http://127.0.0.1:3006
# Bearer for GET /metrics (backend) and GET /api/metrics (site-publico). Required for Prometheus scrape.
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN_MIN_32_CHARS
# PR 17 — Cloudflare Turnstile (site key no front; secret no backend)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# PR 17 — OG fallback
OG_DEFAULT_IMAGE_URL=https://www.reserveiviagens.com.br/og/rsv360-1200x630.png
# marketing-lab: :3000 = lab; B2C/S1 em PRIMARY_SITE_URL (dev :5000 Crm-RSV-360).
# O botão Voltar do wizard (canal=s1-hoteis) usa esta URL — em VPS/prod defina o
# domínio real do S1 no compose (senão o botão aponta para localhost inexistente).
RSV360_APP_MODE=marketing-lab
NEXT_PUBLIC_APP_MODE=marketing-lab
NEXT_PUBLIC_PRIMARY_SITE_URL=http://localhost:5000
NEXT_PUBLIC_LAB_TITLE=RSV360 Marketing Lab
NEXT_PUBLIC_TURISMO_URL=http://localhost:3005
NEXT_PUBLIC_ADMIN_URL=http://localhost:3004
NEXT_PUBLIC_GUEST_URL=http://localhost:3006
ENTERPRISE_DEFAULT_ID=ent_1

# ============================================
# GUEST PORTAL
# ============================================
PORTAL_BASE_URL=http://localhost:3000/portal
PORTAL_TOKEN_EXPIRY_DAYS=7

# ============================================
# HOUSEKEEPING
# ============================================
HK_AUTO_SCHEDULE_ENABLED=true
HK_AUTO_SCHEDULE_HOUR=6
HK_DEFAULT_TASK_MINUTES=30
HK_INSPECTION_REQUIRED=true
HK_MIN_INSPECTION_RATING=4

# ============================================
# REVENUE ENGINE
# ============================================
DEFAULT_BASE_PRICE=250.00
MIN_ROOM_PRICE=50.00
MAX_ROOM_PRICE=9999.00
REVENUE_CURRENCY=BRL
FORECAST_HISTORY_YEARS=3
RATE_CALENDAR_AUTO_GENERATE=true

# ============================================
# CRM & LOYALTY
# ============================================
CRM_DEFAULT_POINTS_PER_BRL=1.0
CRM_POINTS_EXPIRY_DAYS=365
CRM_LOYALTY_PROGRAM_NAME=RSV360 Fidelidade

# ============================================
# MULTI-PROPERTY
# ============================================
DEFAULT_PROPERTY_ID=1
MAX_PROPERTIES_PER_USER=10

# ============================================
# IA (CaldasAI + Copiloto) — Fase 1 migração
# ============================================
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=Voce e o CaldasAI, assistente virtual da Reservei Viagens em Caldas Novas e Rio Quente.

# ============================================
# WhatsApp (Evolution API / WAAS) — Fase 1 migração
# ============================================
WAAS_API_URL=http://localhost:8080
WAAS_API_KEY=

# ============================================
# PRODUCTION SPECIFIC
# ============================================
# NODE_ENV=production (set in docker-compose.prod.yml)
# NODE_ENV=staging (set in docker-compose.staging.yml)

# ============================================
# SSL CERTIFICATES
# ============================================
# Place your SSL certificates in docker/nginx/ssl/
# - cert.pem (full chain certificate)
# - key.pem (private key)

# ============================================
# HTTP SECURITY HEADERS (PR-05a)
# ============================================
# HSTS only when serving HTTPS in production/staging behind TLS.
# NEVER set true on local HTTP — browsers pin HSTS and break http://localhost.
# No preload. Real VPS activation is a separate ops wave.
ENABLE_HSTS=false

# PR-16c / PR-16d-telemetry — CSP Report-Only collectors (never enforce here)
# CSP_REPORT_URI=/api/csp-report
# Per Next app label for aggregates (site-publico | admin | guest | turismo)
# CSP_TELEMETRY_APP=site-publico
# Optional JSONL path (sanitized lines only — no PII). Aggregate with:
#   node scripts/csp-telemetry-aggregate.cjs ./var/csp-telemetry.jsonl
# CSP_TELEMETRY_FILE=

# ============================================
# SECURITY NOTES
# ============================================
# - Use strong, unique passwords for all services
# - JWT_SECRET should be at least 32 characters
# - Store this file securely and never commit to version control
# - Use different values for staging and production
# - ENABLE_HSTS=true only with TLS (prod/VPS); leave false in lab/dev HTTP
# - CORS_ORIGIN: comma-separated allowlist (never '*'); include 127.0.0.1 variants in lab
# - METRICS_TOKEN: required for /metrics scrape (Prometheus) and /api/metrics

# ============================================
# COMMUNICATION - EMAIL (SMTP)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RSV360 <noreply@rsv360.dev>"
SMTP_SECURE=false
# Base URL for co-host invite accept links (turismo app). Falls back to NEXT_PUBLIC_TURISMO_URL.
# COANFITRIAO_INVITE_BASE_URL=https://turismo.example.com

# ============================================
# AUTH — PASSWORD RESET E-MAIL (D2.8 / PR-16a)
# ============================================
# Cadeia canônica (backend buildResetUrl — NUNCA Host / X-Forwarded-Host):
#   1) PASSWORD_RESET_BASE_URL     (específica do reset)
#   2) NEXT_PUBLIC_PRIMARY_SITE_URL | PRIMARY_SITE_URL  (canônica do site)
# Produção: base ausente → fail-closed (erro explícito; sem link localhost).
# Dev: fallback http://localhost:3000 permitido.
# FRONTEND_URL NÃO entra na cadeia (só Playwright/CORS legado — não use para reset).
PASSWORD_RESET_BASE_URL=http://localhost:3000
# Alias legado do slot específico (mesmo efeito que PASSWORD_RESET_BASE_URL)
# PASSWORD_RESET_URL_BASE=
# Fallback canônico se PASSWORD_RESET_* ausente (mesmo valor do site-publico)
# NEXT_PUBLIC_PRIMARY_SITE_URL=http://localhost:5000
# PRIMARY_SITE_URL=http://localhost:5000
# Webhook HTTP (prioridade sobre SMTP) — payload JSON: to, name, resetUrl, subject, html, text
PASSWORD_RESET_EMAIL_WEBHOOK=
PASSWORD_RESET_EMAIL_WEBHOOK_SECRET=
PASSWORD_RESET_EMAIL_FROM=noreply@rsv360.dev
# SES via SMTP: SMTP_HOST=email-smtp.us-east-1.amazonaws.com + credenciais IAM SMTP

# ============================================
# AUTH — OAUTH SOCIAL (D2.9, site-publico BFF)
# ============================================
# Segredo compartilhado BFF ↔ backend (obrigatório em produção)
OAUTH_BFF_SECRET=CHANGE_ME_OAUTH_BFF_SECRET
# Dev sem credenciais Google/Facebook: OAUTH_DEV_MOCK=true
OAUTH_DEV_MOCK=false

# ============================================
# AUTH — SSO S1↔S2 Marketing Lab (Fase 4)
# ============================================
# Segredo BFF ↔ backend para emitir códigos handoff (fallback: OAUTH_BFF_SECRET)
SSO_BFF_SECRET=
# Simula handoff do :5000 em dev: GET /api/auth/sso/dev-handoff
SSO_DEV_MOCK=true
# Exige JWT nas rotas lab (além de MARKETING_LAB_REQUIRE_AUTH no site-publico)
MARKETING_LAB_REQUIRE_AUTH=false
MARKETING_LAB_URL=http://localhost:3000
# Demo KPIs no dashboard se tabelas marketing_* ausentes (dev Docker)
LAB_METRICS_DEMO=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GATE-PROD-01 — UI mock de contratos/assinatura (turismo). Prod = false (bloqueia telas).
# Dev lab: true mostra o mock com banner DEMO (sem validade jurídica).
NEXT_PUBLIC_ENABLE_CONTRATOS_MOCK=false

# ============================================
# COTAÇÃO V2 — HUB FORNECEDORES (PR 3)
# ============================================
# Roteiro Inteligente — motor inerte no PR A; experiência no PR B (dev)
ROTEIRO_INTELIGENTE_ENABLED=false

# Cloudflare Turnstile — site key de teste (sempre passa) é pública; secret obrigatório no compose (PR-09b)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=CHANGE_ME_TURNSTILE_SECRET_OR_CF_TEST_KEY
# Ausência de secret em scripts locais = bypass com aviso (nunca bloquear fluxo local fora do compose)
TURNSTILE_DEV_BYPASS_WARN=true

# Rate limit proposta — dev folgado (prod usa defaults 45s cooldown)
PROPOSTA_SUCCESS_COOLDOWN_MS=0
PROPOSTA_ATTEMPT_DEBOUNCE_MS=0

# Chave para criptografia AES-256-GCM de api_key em fornecedores_api (nunca commitar valor real)
FORNECEDORES_ENCRYPTION_KEY=
# PR-09b: default compose = false (era true). Só ligue temporariamente durante migração.
FORNECEDORES_ALLOW_PLAINTEXT_API_KEY=false

# ============================================
# COMMUNICATION - SENDGRID (ALTERNATIVA SMTP)
# ============================================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@rsv360.dev

# ============================================
# COMMUNICATION - TWILIO SMS
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================
# COMMUNICATION - WHATSAPP BUSINESS
# ============================================
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
