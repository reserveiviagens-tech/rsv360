# Copy to .env.local (gitignored). Restart dev server after changes.
#
# Browser calls same-origin /api/v1 (Next proxy + resolveApiBaseUrl).
# NEXT_PUBLIC_* is SSR/build fallback only:
NEXT_PUBLIC_API_URL=http://localhost:3005
#
# Direct backend (only if not using the Next proxy):
# NEXT_PUBLIC_API_URL=http://localhost:3002
